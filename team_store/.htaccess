<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laravel default .htaccess rules
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Allow iframe embedding from https://encr.co only
<IfModule mod_headers.c>
    Header set X-Frame-Options "ALLOW-FROM https://encr.co"
    Header set Content-Security-Policy "frame-ancestors 'self' https://encr.co"
</IfModule>

# Optional: Prevent MIME sniffing (good practice)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Optional: Cross-Origin Resource Sharing (adjust as needed)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
